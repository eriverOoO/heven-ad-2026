<?xml version="1.0"?>
<package format="3">
  <name>ad_morai_bridge</name>
  <version>0.1.0</version>
  <description>Competition-safe MORAI SIM 24.R2 UDP bridge with an optional localization compatibility boundary.</description>
  <maintainer email="taeyeong@users.noreply.github.com">Taeyeong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ad_morai_interfaces</exec_depend>
  <exec_depend>velodyne_msgs</exec_depend>
  <exec_depend>velodyne_pointcloud</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
