+void CenterPointTRT::captureRawHead(RawHeadDebug & output)
+{
+  const auto grid_size = config_.down_grid_size_x_ * config_.down_grid_size_y_;
+  output.class_size = config_.class_size_;
+  output.offset_size = config_.head_out_offset_size_;
+  output.z_size = config_.head_out_z_size_;
+  output.dim_size = config_.head_out_dim_size_;
+  output.rot_size = config_.head_out_rot_size_;
+  output.vel_size = config_.head_out_vel_size_;
+  output.height = config_.down_grid_size_y_;
+  output.width = config_.down_grid_size_x_;
+  output.voxel_size_x = config_.voxel_size_x_;
+  output.voxel_size_y = config_.voxel_size_y_;
+  output.range_min_x = config_.range_min_x_;
+  output.range_min_y = config_.range_min_y_;
+  output.downsample_factor = config_.downsample_factor_;
+  output.distance_bin_upper_limits = config_.distance_bin_upper_limits_;
+  output.score_thresholds = config_.score_thresholds_;
+  output.yaw_norm_thresholds = config_.yaw_norm_thresholds_;
+
+  const auto copy_output = [grid_size](
+                             const float * source, const std::size_t channels,
+                             std::vector<float> & destination) {
+    destination.resize(grid_size * channels);
+    CHECK_CUDA_ERROR(cudaMemcpy(
+      destination.data(), source, destination.size() * sizeof(float), cudaMemcpyDeviceToHost));
+  };
+  copy_output(head_out_heatmap_d_.get(), config_.class_size_, output.heatmap);
+  copy_output(head_out_offset_d_.get(), config_.head_out_offset_size_, output.offset);
+  copy_output(head_out_z_d_.get(), config_.head_out_z_size_, output.z);
+  copy_output(head_out_dim_d_.get(), config_.head_out_dim_size_, output.dim);
+  copy_output(head_out_rot_d_.get(), config_.head_out_rot_size_, output.rot);
+  copy_output(head_out_vel_d_.get(), config_.head_out_vel_size_, output.vel);
+}
