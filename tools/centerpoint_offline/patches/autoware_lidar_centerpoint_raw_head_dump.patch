+void write_float_binary(const std::filesystem::path & path, const std::vector<float> & values)
+{
+  std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+  if (!stream) {
+    throw std::runtime_error("failed to open raw-head output " + path.string());
+  }
+  stream.write(
+    reinterpret_cast<const char *>(values.data()),
+    static_cast<std::streamsize>(values.size() * sizeof(float)));
+  if (!stream) {
+    throw std::runtime_error("failed to write raw-head output " + path.string());
+  }
+}
+
+void write_float_array(std::ostream & stream, const std::vector<float> & values)
+{
+  stream << '[';
+  for (std::size_t index = 0; index < values.size(); ++index) {
+    if (index != 0) {
+      stream << ',';
+    }
+    stream << std::setprecision(9) << values[index];
+  }
+  stream << ']';
+}
+
+void write_raw_head_debug(
+  const std::filesystem::path & directory, const std::int64_t timestamp_ns,
+  const RawHeadDebug & raw)
+{
+  std::filesystem::create_directories(directory);
+  const auto prefix = directory / std::to_string(timestamp_ns);
+  if (std::filesystem::exists(prefix.string() + "_meta.json")) {
+    return;
+  }
+  write_float_binary(prefix.string() + "_heatmap.f32", raw.heatmap);
+  write_float_binary(prefix.string() + "_reg.f32", raw.offset);
+  write_float_binary(prefix.string() + "_height.f32", raw.z);
+  write_float_binary(prefix.string() + "_dim.f32", raw.dim);
+  write_float_binary(prefix.string() + "_rot.f32", raw.rot);
+  write_float_binary(prefix.string() + "_vel.f32", raw.vel);
+
+  std::ofstream metadata(prefix.string() + "_meta.json", std::ios::trunc);
+  if (!metadata) {
+    throw std::runtime_error("failed to open raw-head metadata output");
+  }
+  metadata << "{\n"
+           << "  \"timestamp_ns\": " << timestamp_ns << ",\n"
+           << "  \"dtype\": \"float32\",\n"
+           << "  \"layout\": \"NCHW_without_batch\",\n"
+           << "  \"class_size\": " << raw.class_size << ",\n"
+           << "  \"height\": " << raw.height << ",\n"
+           << "  \"width\": " << raw.width << ",\n"
+           << "  \"voxel_size_x\": " << raw.voxel_size_x << ",\n"
+           << "  \"voxel_size_y\": " << raw.voxel_size_y << ",\n"
+           << "  \"range_min_x\": " << raw.range_min_x << ",\n"
+           << "  \"range_min_y\": " << raw.range_min_y << ",\n"
+           << "  \"downsample_factor\": " << raw.downsample_factor << ",\n"
+           << "  \"bindings\": {\"heatmap\": " << raw.class_size
+           << ", \"reg\": " << raw.offset_size
+           << ", \"height\": " << raw.z_size
+           << ", \"dim\": " << raw.dim_size
+           << ", \"rot\": " << raw.rot_size
+           << ", \"vel\": " << raw.vel_size << "},\n"
+           << "  \"distance_bin_upper_limits\": ";
+  write_float_array(metadata, raw.distance_bin_upper_limits);
+  metadata << ",\n  \"score_thresholds\": ";
+  write_float_array(metadata, raw.score_thresholds);
+  metadata << ",\n  \"yaw_norm_thresholds\": ";
+  write_float_array(metadata, raw.yaw_norm_thresholds);
+  metadata << "\n}\n";
+}
