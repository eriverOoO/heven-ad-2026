<?xml version="1.0"?>
<package format="3">
  <name>ad_bringup</name>
  <version>0.1.0</version>
  <description>ROS 2 launch profiles for the HEVEN AD stack.</description>
  <maintainer email="taeyeong@users.noreply.github.com">Taeyeong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ad_description</exec_depend>
  <exec_depend>ad_localization</exec_depend>
  <exec_depend>ad_morai_bridge</exec_depend>
  <exec_depend>ad_morai_bridge_dev</exec_depend>
  <exec_depend>ad_lidar_perception</exec_depend>
  <exec_depend>ad_camera_perception</exec_depend>
  <exec_depend>ad_planner</exec_depend>
  <exec_depend>ad_viz</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
