+  /// Reinitialize only the velocity error-state uncertainty before an externally
+  /// validated standstill observation. The nominal state is deliberately left
+  /// unchanged so the following ZUPT remains a normal Kalman measurement update.
+  ObservationUpdateStatus resetVelocityCovarianceForStandstill(
+    const Eigen::Vector3d & velocity_variance)
+  {
+    if (!velocity_variance.allFinite() || (velocity_variance.array() <= 0.0).any()) {
+      return ObservationUpdateStatus::kInvalidVariance;
+    }
+
+    const Snapshot before = getSnapshot();
+    P_.block(ERROR_STATE::DVX, 0, 3, num_error_state_).setZero();
+    P_.block(0, ERROR_STATE::DVX, num_error_state_, 3).setZero();
+    P_.block<3, 3>(ERROR_STATE::DVX, ERROR_STATE::DVX).diagonal() = velocity_variance;
+    P_ = 0.5 * (P_ + P_.transpose());
+    if (!checkNumericalInvariants()) {
+      (void)restoreSnapshot(before);
+      return ObservationUpdateStatus::kNumericalFailure;
+    }
+    return ObservationUpdateStatus::kUpdated;
+  }
