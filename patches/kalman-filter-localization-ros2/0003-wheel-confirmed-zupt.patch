+  EXPECT_EQ(detector.update(0.49, gyro, accel, 0.0, 9.80665, false),
+    StationaryDetector::State::kMoving);
+  EXPECT_EQ(detector.update(0.50, gyro, accel, 0.0, 9.80665, true),
+    StationaryDetector::State::kCandidate);
+  EXPECT_EQ(detector.update(0.99, gyro, accel, 0.0, 9.80665, true),
+    StationaryDetector::State::kCandidate);
