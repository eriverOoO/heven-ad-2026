+TEST(EKFEstimatorCore, StandstillVelocityCovarianceResetIsAtomicAndKeepsNominalState)
+{
+  EKFEstimator estimator;
+  auto initial = estimator.getSnapshot();
+  initial.state.position = Eigen::Vector3d(12.0, -4.0, 1.5);
+  initial.state.velocity = Eigen::Vector3d(0.42, -0.17, 0.31);
+  initial.state.orientation = Eigen::Quaterniond(
+    Eigen::AngleAxisd(0.3, Eigen::Vector3d::UnitZ()));
+  initial.state.gyro_bias = Eigen::Vector3d(0.01, -0.02, 0.03);
+  initial.state.accel_bias = Eigen::Vector3d(0.1, -0.05, 0.02);
+  initial.covariance.setIdentity();
+  initial.covariance.block<3, 3>(0, 3) = 0.2 * Eigen::Matrix3d::Identity();
+  initial.covariance.block<3, 3>(3, 0) = 0.2 * Eigen::Matrix3d::Identity();
+  initial.covariance.block<3, 3>(3, 6) = 0.1 * Eigen::Matrix3d::Identity();
+  initial.covariance.block<3, 3>(6, 3) = 0.1 * Eigen::Matrix3d::Identity();
+  ASSERT_TRUE(estimator.restoreSnapshot(initial));
+
+  const auto before = estimator.getSnapshot();
+  const Eigen::Vector3d reset_variance(1.0e-4, 2.0e-4, 3.0e-4);
+  ASSERT_EQ(
+    estimator.resetVelocityCovarianceForStandstill(reset_variance),
+    EKFEstimator::ObservationUpdateStatus::kUpdated);
+
+  const auto after = estimator.getSnapshot();
+  const Eigen::Matrix3d reset_covariance = reset_variance.asDiagonal();
+  EXPECT_TRUE(after.state.velocity.isApprox(before.state.velocity, 0.0));
+  EXPECT_TRUE(after.state.position.isApprox(before.state.position, 0.0));
+  EXPECT_TRUE(after.state.orientation.coeffs().isApprox(
+      before.state.orientation.coeffs(), 0.0));
+  EXPECT_TRUE(after.state.gyro_bias.isApprox(before.state.gyro_bias, 0.0));
+  EXPECT_TRUE(after.state.accel_bias.isApprox(before.state.accel_bias, 0.0));
+  EXPECT_TRUE(
+    (after.covariance.block<3, 3>(3, 3).isApprox(
+      reset_covariance, 0.0)));
+  EXPECT_TRUE(after.covariance.block(3, 0, 3, 3).isZero(0.0));
+  EXPECT_TRUE(after.covariance.block(3, 6, 3, 9).isZero(0.0));
+  EXPECT_TRUE(after.covariance.block(0, 3, 3, 3).isZero(0.0));
+  EXPECT_TRUE(after.covariance.block(6, 3, 9, 3).isZero(0.0));
+  EXPECT_TRUE(
+    (after.covariance.block<3, 3>(0, 0).isApprox(
+      before.covariance.block<3, 3>(0, 0), 0.0)));
+  EXPECT_TRUE(
+    after.covariance.block(6, 6, 9, 9).isApprox(
+      before.covariance.block(6, 6, 9, 9), 0.0));
+  EXPECT_TRUE(estimator.checkNumericalInvariants());
+
+  const auto valid = estimator.getSnapshot();
+  const Eigen::VectorXd valid_x = estimator.getX();
+  EXPECT_EQ(
+    estimator.resetVelocityCovarianceForStandstill(
+      Eigen::Vector3d(0.0, 1.0e-4, 1.0e-4)),
+    EKFEstimator::ObservationUpdateStatus::kInvalidVariance);
+  EXPECT_TRUE(estimator.getX().isApprox(valid_x, 0.0));
+  EXPECT_TRUE(estimator.getSnapshot().state.velocity.isApprox(valid.state.velocity, 0.0));
+  EXPECT_TRUE(estimator.getCovariance().isApprox(valid.covariance, 0.0));
+
+  Eigen::Vector3d nonfinite_variance = reset_variance;
+  nonfinite_variance.z() = std::numeric_limits<double>::quiet_NaN();
+  EXPECT_EQ(
+    estimator.resetVelocityCovarianceForStandstill(nonfinite_variance),
+    EKFEstimator::ObservationUpdateStatus::kInvalidVariance);
+  EXPECT_TRUE(estimator.getX().isApprox(valid_x, 0.0));
+  EXPECT_TRUE(estimator.getCovariance().isApprox(valid.covariance, 0.0));
+}
