+inline bool hasFreshStationaryWheelEvidence(
+  const double sensor_time_sec, const double wheel_time_sec,
+  const double wheel_speed_mps, const double maximum_age_sec,
+  const double maximum_abs_speed_mps)
+{
+  if (!std::isfinite(sensor_time_sec) || !std::isfinite(wheel_time_sec) ||
+    !std::isfinite(wheel_speed_mps) || !std::isfinite(maximum_age_sec) ||
+    !std::isfinite(maximum_abs_speed_mps) || maximum_age_sec < 0.0 ||
+    maximum_abs_speed_mps < 0.0)
+  {
+    return false;
+  }
+  const double age_sec = sensor_time_sec - wheel_time_sec;
+  return age_sec >= 0.0 && age_sec <= maximum_age_sec &&
+         std::fabs(wheel_speed_mps) <= maximum_abs_speed_mps;
+}
