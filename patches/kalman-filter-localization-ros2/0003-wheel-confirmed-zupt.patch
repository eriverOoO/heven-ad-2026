+using namespace std::chrono_literals;
+
+builtin_interfaces::msg::Time stamp(const double seconds)
+{
+  builtin_interfaces::msg::Time result;
+  result.sec = static_cast<std::int32_t>(seconds);
+  result.nanosec = static_cast<std::uint32_t>((seconds - result.sec) * 1.0e9);
+  return result;
+}
+
+bool spinUntil(
+  rclcpp::executors::SingleThreadedExecutor & executor,
+  const std::function<bool()> & predicate,
+  const std::chrono::milliseconds timeout = 1000ms)
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  while (std::chrono::steady_clock::now() < deadline) {
+    executor.spin_some();
+    if (predicate()) {
+      return true;
+    }
+    std::this_thread::sleep_for(2ms);
+  }
+  executor.spin_some();
+  return predicate();
+}
+
+void spinFor(
+  rclcpp::executors::SingleThreadedExecutor & executor,
+  const std::chrono::milliseconds duration)
+{
+  const auto deadline = std::chrono::steady_clock::now() + duration;
+  while (std::chrono::steady_clock::now() < deadline) {
+    executor.spin_some();
+    std::this_thread::sleep_for(2ms);
+  }
+}
+
+TEST(EkfWheelConfirmedZupt, RequiresContinuousFreshZeroWheelEvidence)
+{
+  const std::vector<rclcpp::Parameter> parameters{
+    rclcpp::Parameter("initial_pose_topic", "/wheel_zupt_test/initial_pose"),
+    rclcpp::Parameter("imu_topic", "/wheel_zupt_test/imu"),
+    rclcpp::Parameter("wheel_speed_topic", "/wheel_zupt_test/wheel_speed"),
+    rclcpp::Parameter("output_publish_mode", "imu"),
+    rclcpp::Parameter("publish_tf", false),
+    rclcpp::Parameter("publish_debug_topics", true),
+    rclcpp::Parameter("use_gnss", false),
+    rclcpp::Parameter("use_wheel_speed", true),
+    rclcpp::Parameter("enable_stationary_initialization", false),
+    rclcpp::Parameter("enable_measurement_replay", false),
+    rclcpp::Parameter("use_zupt", true),
+    rclcpp::Parameter("zupt_require_wheel_speed", true),
+    rclcpp::Parameter("zupt_max_wheel_speed_mps", 0.02),
+    rclcpp::Parameter("zupt_max_wheel_age_sec", 0.1),
+    rclcpp::Parameter("zupt_max_speed_mps", 0.1),
+    rclcpp::Parameter("zupt_min_stationary_duration_sec", 0.05),
+    rclcpp::Parameter("zupt_reinitialize_velocity_covariance", true),
+    rclcpp::Parameter("zupt_reinitialization_max_speed_mps", 0.1),
+    rclcpp::Parameter("var_zupt_reinitialized_velocity", 0.25),
+    rclcpp::Parameter("var_zupt_velocity", 0.01)};
+  rclcpp::NodeOptions options;
+  options.arguments({"--ros-args", "-r", "__node:=ekf_wheel_zupt_test"});
+  options.parameter_overrides(parameters);
+
+  const auto ekf_node =
+    std::make_shared<kalman_filter_localization::EkfLocalizationComponent>(options);
+  const auto probe_node = std::make_shared<rclcpp::Node>("ekf_wheel_zupt_probe");
+  const auto initial_pose_pub =
+    probe_node->create_publisher<geometry_msgs::msg::PoseStamped>(
+    "/wheel_zupt_test/initial_pose", 10);
+  const auto imu_pub = probe_node->create_publisher<sensor_msgs::msg::Imu>(
+    "/wheel_zupt_test/imu", rclcpp::SensorDataQoS());
+  const auto wheel_pub =
+    probe_node->create_publisher<geometry_msgs::msg::TwistWithCovarianceStamped>(
+    "/wheel_zupt_test/wheel_speed", rclcpp::SensorDataQoS());
+  std::size_t zupt_update_count = 0U;
+  std::size_t velocity_covariance_reinitialization_count = 0U;
+  const auto debug_sub = probe_node->create_subscription<std_msgs::msg::Float64MultiArray>(
+    "/ekf_wheel_zupt_test/debug/update_delta", 10,
+    [&zupt_update_count, &velocity_covariance_reinitialization_count](
+      std_msgs::msg::Float64MultiArray::ConstSharedPtr message)
+    {
+      if (message->data.size() >= 3U && message->data[1] == 6.0 &&
+      message->data[2] > 0.0)
+      {
+        ++zupt_update_count;
+        if (message->data[2] == 2.0) {
+          ++velocity_covariance_reinitialization_count;
+        }
+      }
+    });
+
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(ekf_node);
+  executor.add_node(probe_node);
+  ASSERT_TRUE(
+    spinUntil(
+      executor, [&]() {
+        return initial_pose_pub->get_subscription_count() == 1U &&
+        imu_pub->get_subscription_count() == 1U &&
+        wheel_pub->get_subscription_count() == 1U &&
+        debug_sub->get_publisher_count() == 1U;
+      }));
+
+  geometry_msgs::msg::PoseStamped initial_pose;
+  initial_pose.header.stamp = stamp(10.0);
+  initial_pose.header.frame_id = "map";
+  initial_pose.pose.orientation.w = 1.0;
+  initial_pose_pub->publish(initial_pose);
+  spinFor(executor, 20ms);
+
+  const auto publish_imu = [&](const double time) {
+      sensor_msgs::msg::Imu message;
+      message.header.stamp = stamp(time);
+      message.header.frame_id = "base_link";
+      message.orientation.w = 1.0;
+      message.linear_acceleration.z = 9.80665;
+      imu_pub->publish(message);
+      spinFor(executor, 5ms);
+    };
+  const auto publish_wheel = [&](const double time, const double speed) {
+      geometry_msgs::msg::TwistWithCovarianceStamped message;
+      message.header.stamp = stamp(time);
+      message.header.frame_id = "base_link";
+      message.twist.twist.linear.x = speed;
+      wheel_pub->publish(message);
+      spinFor(executor, 5ms);
+    };
+
+  for (int index = 1; index <= 6; ++index) {
+    publish_imu(10.0 + index * 0.02);
+  }
+  EXPECT_EQ(zupt_update_count, 0U);
+
+  for (int index = 7; index <= 12; ++index) {
+    const double time = 10.0 + index * 0.02;
+    publish_wheel(time, 0.03);
+    publish_imu(time);
+  }
+  EXPECT_EQ(zupt_update_count, 0U);
+
+  for (int index = 13; index <= 15; ++index) {
+    const double time = 10.0 + index * 0.02;
+    publish_wheel(time, 0.0);
+    publish_imu(time);
+  }
+  EXPECT_EQ(zupt_update_count, 0U);
+
+  publish_wheel(10.32, 0.0);
+  publish_imu(10.32);
+  ASSERT_TRUE(spinUntil(executor, [&]() {return zupt_update_count > 0U;}));
+  EXPECT_EQ(velocity_covariance_reinitialization_count, 1U);
+
+  publish_wheel(10.33, 0.0);
+  publish_imu(10.33);
+  EXPECT_EQ(velocity_covariance_reinitialization_count, 1U);
+
+  const std::size_t before_motion = zupt_update_count;
+  publish_wheel(10.34, -0.03);
+  publish_imu(10.34);
+  spinFor(executor, 20ms);
+  EXPECT_EQ(zupt_update_count, before_motion);
+
+  for (int index = 18; index <= 21; ++index) {
+    const double time = 10.0 + index * 0.02;
+    publish_wheel(time, 0.0);
+    publish_imu(time);
+  }
+  ASSERT_TRUE(
+    spinUntil(
+      executor, [&]() {return velocity_covariance_reinitialization_count == 2U;}));
+  EXPECT_EQ(velocity_covariance_reinitialization_count, 2U);
+}
