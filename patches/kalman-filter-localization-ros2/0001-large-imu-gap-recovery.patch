+builtin_interfaces::msg::Time stamp(const double seconds)
+{
+  builtin_interfaces::msg::Time result;
+  result.sec = static_cast<std::int32_t>(seconds);
+  result.nanosec = static_cast<std::uint32_t>((seconds - result.sec) * 1.0e9);
+  return result;
+}
+
+bool spinUntil(
+  rclcpp::executors::SingleThreadedExecutor & executor,
+  const std::function<bool()> & predicate,
+  const std::chrono::milliseconds timeout = 1000ms)
+{
+  const auto deadline = std::chrono::steady_clock::now() + timeout;
+  while (std::chrono::steady_clock::now() < deadline) {
+    executor.spin_some();
+    if (predicate()) {
+      return true;
+    }
+    std::this_thread::sleep_for(2ms);
+  }
+  executor.spin_some();
+  return predicate();
+}
