+TEST(EskfReplay, ClassifiesLargeImuGapWithoutMutatingEstimator)
+{
+  EKFEstimator estimator;
+  configure(estimator);
+  ASSERT_TRUE(estimator.setMaxPredictionDtSec(0.5));
+  EskfReplay replay(estimator, 2.0);
+  const Eigen::Vector3d gyro(0.01, -0.02, 0.03);
+  const Eigen::Vector3d acceleration(0.2, -0.1, 9.80665);
+  ASSERT_EQ(replay.addImu(10.0, gyro, acceleration), EskfReplay::Status::kInitialized);
+
+  const auto state_before_gap = estimator.getX();
+  const auto covariance_before_gap = estimator.getCovariance();
+  const auto status = replay.addImu(11.0, gyro, acceleration);
+
+  EXPECT_EQ(status, EskfReplay::Status::kLargeGap);
+  EXPECT_LT((estimator.getX() - state_before_gap).norm(), 1.0e-15);
+  EXPECT_LT((estimator.getCovariance() - covariance_before_gap).norm(), 1.0e-15);
+  EXPECT_DOUBLE_EQ(replay.latestTime(), 10.0);
+  EXPECT_EQ(replay.imuHistorySize(), 1U);
+  EXPECT_EQ(replay.counters().invalid_input, 0U);
+  EXPECT_EQ(replay.counters().large_imu_gap, 1U);
+}
+
+TEST(EskfReplay, ResetAfterLargeGapStartsIsolatedEpoch)
+{
+  EKFEstimator estimator;
+  configure(estimator);
+  ASSERT_TRUE(estimator.setMaxPredictionDtSec(0.5));
+  EskfReplay replay(estimator, 2.0);
+  const Eigen::Vector3d gyro = Eigen::Vector3d::Zero();
+  const Eigen::Vector3d acceleration(0.0, 0.0, 9.80665);
+  const Eigen::Vector3d variance = Eigen::Vector3d::Constant(0.1);
+  ASSERT_EQ(replay.addImu(10.0, gyro, acceleration), EskfReplay::Status::kInitialized);
+  ASSERT_EQ(
+    replay.applyMeasurement(
+      10.2, 10.0, 77U, positionUpdate(Eigen::Vector3d::Ones(), variance)),
+    EskfReplay::Status::kQueuedFuture);
+  EXPECT_EQ(
+    replay.measurementDisposition(77U), EskfReplay::MeasurementDisposition::kPending);
+
+  const auto state_before_gap = estimator.getX();
+  const auto covariance_before_gap = estimator.getCovariance();
+  const auto gap_status = replay.addImu(11.0, gyro, acceleration);
+  ASSERT_EQ(gap_status, EskfReplay::Status::kLargeGap);
+
+  replay.reset();
+  ASSERT_EQ(replay.addImu(11.0, gyro, acceleration), EskfReplay::Status::kInitialized);
+  EXPECT_EQ(replay.imuHistorySize(), 1U);
+  EXPECT_EQ(replay.measurementHistorySize(), 0U);
+  EXPECT_EQ(
+    replay.measurementDisposition(77U), EskfReplay::MeasurementDisposition::kUnknown);
+  EXPECT_LT((estimator.getX() - state_before_gap).norm(), 1.0e-15);
+  EXPECT_LT((estimator.getCovariance() - covariance_before_gap).norm(), 1.0e-15);
+  EXPECT_EQ(
+    replay.applyMeasurement(
+      10.2, 11.0, 77U, positionUpdate(Eigen::Vector3d::Ones(), variance)),
+    EskfReplay::Status::kTooOld);
+  EXPECT_EQ(replay.addImu(11.01, gyro, acceleration), EskfReplay::Status::kApplied);
+  EXPECT_EQ(
+    replay.applyMeasurement(
+      11.01, 11.01, 78U, positionUpdate(Eigen::Vector3d::Zero(), variance)),
+    EskfReplay::Status::kApplied);
+  EXPECT_EQ(
+    replay.measurementDisposition(78U), EskfReplay::MeasurementDisposition::kApplied);
+}
+
