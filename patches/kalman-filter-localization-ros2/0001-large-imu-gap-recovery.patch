+  {
+    geometry_msgs::msg::PoseStamped message;
+    message.header.stamp = stamp(time);
+    message.header.frame_id = "map";
+    message.pose.position.x = std::numeric_limits<double>::quiet_NaN();
+    message.pose.orientation.w = 1.0;
+    gnss_pub_->publish(message);
+  }
+
+  void publishWheelSpeed(const double time)
+  {
+    geometry_msgs::msg::TwistWithCovarianceStamped message;
+    message.header.stamp = stamp(time);
+    message.header.frame_id = "base_link";
+    wheel_pub_->publish(message);
+  }
+
+  rclcpp::executors::SingleThreadedExecutor executor_;
+  std::shared_ptr<kalman_filter_localization::EkfLocalizationComponent> ekf_node_;
+  rclcpp::Node::SharedPtr probe_node_;
+  rclcpp::Publisher<geometry_msgs::msg::PoseStamped>::SharedPtr initial_pose_pub_;
+  rclcpp::Publisher<sensor_msgs::msg::Imu>::SharedPtr imu_pub_;
+  rclcpp::Publisher<geometry_msgs::msg::PoseStamped>::SharedPtr gnss_pub_;
+  rclcpp::Publisher<geometry_msgs::msg::TwistWithCovarianceStamped>::SharedPtr wheel_pub_;
+  rclcpp::Subscription<geometry_msgs::msg::PoseStamped>::SharedPtr pose_sub_;
+  rclcpp::Subscription<nav_msgs::msg::Odometry>::SharedPtr odometry_sub_;
+  std::vector<builtin_interfaces::msg::Time> output_stamps_;
+  std::vector<double> output_positions_x_;
+  std::size_t odometry_output_count_{0U};
+};
+
+class EkfLargeGapNoGnssTest : public EkfLargeGapRecoveryTest
+{
+protected:
+  EkfLargeGapNoGnssTest() {use_gnss_ = false;}
+};
+
+TEST_F(EkfLargeGapRecoveryTest, SuppressesFreshOutputUntilPostGapGnssIsApplied)
+{
+  publishInitialPose(10.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(10.0);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 1U;}));
+  publishImu(10.01);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 2U;}));
+  const std::size_t output_count_before_gap = output_stamps_.size();
+  const std::size_t odometry_count_before_gap = odometry_output_count_;
+
+  publishImu(11.0);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap);
+  publishWheelSpeed(11.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(11.01);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap);
+
+  publishInvalidGnss(11.01);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  EXPECT_EQ(output_stamps_.size(), output_count_before_gap);
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap);
+
+  // More than the bounded candidate capacity: alternating isolated outliers must never form a
+  // consistent recovery sequence or release the output gate.
+  for (int index = 0; index < 80; ++index) {
+    const double outlier_x = index % 2 == 0 ? 100.0 : -100.0;
+    publishGnss(11.011 + static_cast<double>(index) * 1.0e-5, outlier_x);
+    ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  }
+  // Even a coherent high-rate burst cannot satisfy the independent minimum time span.
+  for (int index = 0; index < 80; ++index) {
+    publishGnss(11.012 + static_cast<double>(index) * 1.0e-5, 20.0 + index * 1.0e-3);
+    ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  }
+  // Duplicate, reverse, and excessively separated stamps each restart consistency collection.
+  publishGnss(11.013, 0.0);
+  publishGnss(11.013, 0.1);
+  publishGnss(11.0129, 0.2);
+  publishGnss(14.0, 0.3);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(11.02);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap);
+
+  publishGnss(11.025, 0.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(11.03);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+
+  publishGnss(11.035, 0.1);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(11.04);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+
+  publishGnss(11.045, 0.2);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  EXPECT_EQ(output_stamps_.size(), output_count_before_gap);
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap);
+  // The trusted third fix is queued in replay. A later fix must not schedule a second re-anchor.
+  publishGnss(11.046, 1000.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(11.05);
+  ASSERT_TRUE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() == output_count_before_gap + 1U;
+      }));
+  EXPECT_EQ(odometry_output_count_, odometry_count_before_gap + 1U);
+  EXPECT_EQ(output_stamps_.back().sec, 11);
+  EXPECT_NEAR(output_stamps_.back().nanosec, 50000000U, 2U);
+  EXPECT_NEAR(output_positions_x_.back(), 0.2, 0.5);
+}
+
+TEST_F(EkfLargeGapRecoveryTest, ConsistentFixesRecoverBeyondNormalInnovationGate)
+{
+  publishInitialPose(30.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(30.0);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 1U;}));
+  publishImu(30.01);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 2U;}));
+  const std::size_t output_count_before_gap = output_stamps_.size();
+
+  publishImu(31.0);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  publishImu(31.01);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+
+  publishGnss(31.015, 100.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(31.02);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  publishGnss(31.025, 101.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(31.03);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  publishGnss(31.035, 102.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(31.04);
+  ASSERT_TRUE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() == output_count_before_gap + 1U;
+      }));
+  EXPECT_NEAR(ekf_node_->get_parameter("max_gnss_position_innovation_m").as_double(), 5.0, 1e-12);
+  ASSERT_FALSE(output_positions_x_.empty());
+  EXPECT_NEAR(output_positions_x_.back(), 102.0, 0.5);
+
+  // After recovery, the ordinary 5 m innovation gate is active again.
+  publishGnss(31.045, 200.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(31.05);
+  ASSERT_TRUE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() == output_count_before_gap + 2U;
+      }));
+  EXPECT_NEAR(output_positions_x_.back(), 102.0, 0.5);
+}
+
+TEST_F(EkfLargeGapNoGnssTest, ResumesOnNextImuWithoutWaitingForUnavailableGnss)
+{
+  publishInitialPose(20.0);
+  ASSERT_TRUE(spinUntil(executor_, []() {return true;}));
+  publishImu(20.0);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 1U;}));
+  publishImu(20.01);
+  ASSERT_TRUE(spinUntil(executor_, [this]() {return output_stamps_.size() >= 2U;}));
+  const std::size_t output_count_before_gap = output_stamps_.size();
+
+  publishImu(21.0);
+  EXPECT_FALSE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() > output_count_before_gap;
+      }, 100ms));
+  publishImu(21.01);
+  ASSERT_TRUE(
+    spinUntil(
+      executor_, [this, output_count_before_gap]() {
+        return output_stamps_.size() == output_count_before_gap + 1U;
+      }));
+  EXPECT_EQ(output_stamps_.back().sec, 21);
+  EXPECT_NEAR(output_stamps_.back().nanosec, 10000000U, 2U);
+}
+
+TEST(EkfConfiguration, RejectsStatefulGnssReacquisitionWithReplay)
+{
+  rclcpp::NodeOptions options;
+  options.arguments({"--ros-args", "-r", "__node:=ekf_invalid_reacquisition_test"});
+  options.parameter_overrides(
+    {rclcpp::Parameter("enable_measurement_replay", true),
+      rclcpp::Parameter("gnss_position_reacquisition_dt_sec", 1.0)});
+  EXPECT_THROW(
+    std::make_shared<kalman_filter_localization::EkfLocalizationComponent>(options),
+    std::invalid_argument);
+}
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  ::testing::InitGoogleTest(&argc, argv);
+  rclcpp::init(argc, argv);
+  const int result = RUN_ALL_TESTS();
+  rclcpp::shutdown();
+  return result;
+}
