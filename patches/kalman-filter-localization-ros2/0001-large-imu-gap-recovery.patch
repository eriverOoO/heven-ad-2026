+TEST(EkfSnapshot, PositionReanchorIsAtomicAndResetsPositionCrossCovariance)
+{
+  EKFEstimator estimator;
+  configure(estimator);
+  const auto before = estimator.getSnapshot();
+  const Eigen::Vector3d position(100.0, -20.0, 3.0);
+  const Eigen::Matrix3d position_covariance =
+    Eigen::Vector3d(0.25, 0.25, 1.0).asDiagonal();
+
+  ASSERT_TRUE(estimator.reanchorPosition(position, position_covariance));
+  EXPECT_LT((estimator.getPosition() - position).norm(), 1.0e-15);
+  const Eigen::MatrixXd covariance = estimator.getCovariance();
+  EXPECT_LT((covariance.block<3, 3>(0, 0) - position_covariance).norm(), 1.0e-15);
+  EXPECT_LT(covariance.block(0, 3, 3, covariance.cols() - 3).norm(), 1.0e-15);
+  EXPECT_LT(covariance.block(3, 0, covariance.rows() - 3, 3).norm(), 1.0e-15);
+  EXPECT_LT(
+    (covariance.block(3, 3, covariance.rows() - 3, covariance.cols() - 3) -
+    before.covariance.block(
+      3, 3, before.covariance.rows() - 3,
+      before.covariance.cols() - 3)).norm(),
+    1.0e-15);
+
+  const auto valid = estimator.getSnapshot();
+  const Eigen::VectorXd valid_x = estimator.getX();
+  Eigen::Matrix3d invalid_covariance = position_covariance;
+  invalid_covariance(0, 0) = -1.0;
+  EXPECT_FALSE(estimator.reanchorPosition(Eigen::Vector3d::Zero(), invalid_covariance));
+  EXPECT_LT((estimator.getX() - valid_x).norm(), 1.0e-15);
+  EXPECT_LT((estimator.getCovariance() - valid.covariance).norm(), 1.0e-15);
+}
