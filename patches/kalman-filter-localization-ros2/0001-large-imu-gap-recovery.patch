+  /// Atomically replace the position state and its uncertainty after an
+  /// externally validated absolute-position re-acquisition.
+  bool reanchorPosition(
+    const Eigen::Vector3d & position, const Eigen::Matrix3d & position_covariance)
+  {
+    const Eigen::Matrix3d symmetric_covariance =
+      0.5 * (position_covariance + position_covariance.transpose());
+    const Eigen::LDLT<Eigen::Matrix3d> decomposition(symmetric_covariance);
+    if (!position.allFinite() || !position_covariance.allFinite() ||
+      decomposition.info() != Eigen::Success || !decomposition.isPositive() ||
+      (symmetric_covariance.diagonal().array() <= 0.0).any())
+    {
+      return false;
+    }
+
+    const Snapshot before = getSnapshot();
+    State state = before.state;
+    state.position = position;
+    setState(state);
+    P_.block<3, 3>(ERROR_STATE::DX, ERROR_STATE::DX) = symmetric_covariance;
+    P_.block(0, 3, 3, num_error_state_ - 3).setZero();
+    P_.block(3, 0, num_error_state_ - 3, 3).setZero();
+    P_ = 0.5 * (P_ + P_.transpose());
+    if (!checkNumericalInvariants()) {
+      (void)restoreSnapshot(before);
+      return false;
+    }
+    return true;
+  }
