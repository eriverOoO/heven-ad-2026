+  bool postGapGnssFixIsConsistent(
+    const double measurement_time, const Eigen::Vector3d & antenna_position,
+    const Eigen::Matrix3d & position_covariance)
+  {
+    const Eigen::LDLT<Eigen::Matrix3d> covariance_decomposition(position_covariance);
+    if (!std::isfinite(measurement_time) || !antenna_position.allFinite() ||
+      !position_covariance.allFinite() ||
+      covariance_decomposition.info() != Eigen::Success ||
+      !covariance_decomposition.isPositive())
+    {
+      resetPostGapGnssConsistency();
+      return false;
+    }
+
+    if (!has_post_gap_gnss_consistency_base_) {
+      has_post_gap_gnss_consistency_base_ = true;
+      post_gap_gnss_consistency_first_time_ = measurement_time;
+      post_gap_gnss_consistency_time_ = measurement_time;
+      post_gap_gnss_consistency_position_ = antenna_position;
+      post_gap_gnss_consistency_covariance_ = position_covariance;
+      post_gap_gnss_consistent_fix_count_ = 1U;
+      return false;
+    }
+
+    const double dt = measurement_time - post_gap_gnss_consistency_time_;
+    const double displacement =
+      (antenna_position - post_gap_gnss_consistency_position_).norm();
+    const double covariance_tolerance = 3.0 * std::sqrt(
+      std::max(
+        0.0,
+        (post_gap_gnss_consistency_covariance_ + position_covariance).diagonal().maxCoeff()));
+    // A single 3-D bound deliberately covers horizontal and vertical motion together. This is
+    // conservative for normal road motion and prevents an implausible jump on either axis.
+    const bool consistent = dt > 0.0 && dt <= post_gap_gnss_max_fix_interval_sec_ &&
+      displacement <= post_gap_gnss_max_speed_mps_ * dt +
+      post_gap_gnss_consistency_tolerance_m_ + covariance_tolerance;
+    if (!consistent) {
+      post_gap_gnss_consistency_first_time_ = measurement_time;
+      post_gap_gnss_consistent_fix_count_ = 1U;
+    } else {
+      post_gap_gnss_consistent_fix_count_ = std::min(
+        post_gap_gnss_consistent_fix_count_ + 1U,
+        static_cast<std::size_t>(post_gap_gnss_required_consistent_fixes_));
+    }
+    post_gap_gnss_consistency_time_ = measurement_time;
+    post_gap_gnss_consistency_position_ = antenna_position;
+    post_gap_gnss_consistency_covariance_ = position_covariance;
+    return post_gap_gnss_consistent_fix_count_ >=
+           static_cast<std::size_t>(post_gap_gnss_required_consistent_fixes_) &&
+           measurement_time - post_gap_gnss_consistency_first_time_ >=
+           post_gap_gnss_min_consistency_span_sec_;
+  }
