+TEST(EkfStationaryInitialization, OptInPublishesGravityObservableAccelBias)
+{
+  const std::vector<rclcpp::Parameter> parameters{
+    rclcpp::Parameter("initial_pose_topic", "/stationary_bias_test/initial_pose"),
+    rclcpp::Parameter("imu_topic", "/stationary_bias_test/imu"),
+    rclcpp::Parameter("output_publish_mode", "imu"),
+    rclcpp::Parameter("publish_tf", false),
+    rclcpp::Parameter("use_gnss", false),
+    rclcpp::Parameter("propagation_model", "legacy"),
+    rclcpp::Parameter("enable_measurement_replay", true),
+    rclcpp::Parameter("measurement_history_duration_sec", 2.0),
+    rclcpp::Parameter("max_future_measurement_wait_sec", 0.25),
+    rclcpp::Parameter("enable_stationary_initialization", true),
+    rclcpp::Parameter("stationary_initialization_estimate_accel_bias", true),
+    rclcpp::Parameter("stationary_initialization_window_sec", 0.1),
+    rclcpp::Parameter("stationary_initialization_min_samples", 10),
+    rclcpp::Parameter("initial_imu_acc_bias_covariance", 0.01),
+    rclcpp::Parameter("tau_acc_bias_sec", 1.0e12),
+    rclcpp::Parameter("gravity_mps2", 9.80665),
+    rclcpp::Parameter("publish_debug_topics", true)};
+  rclcpp::NodeOptions options;
+  options.arguments({"--ros-args", "-r", "__node:=ekf_stationary_bias_test"});
+  options.parameter_overrides(parameters);
+  const auto ekf_node =
+    std::make_shared<kalman_filter_localization::EkfLocalizationComponent>(options);
+  const auto probe_node = std::make_shared<rclcpp::Node>("ekf_stationary_bias_probe");
+  const auto initial_pose_pub =
+    probe_node->create_publisher<geometry_msgs::msg::PoseStamped>(
+    "/stationary_bias_test/initial_pose", 10);
+  const auto imu_pub = probe_node->create_publisher<sensor_msgs::msg::Imu>(
+    "/stationary_bias_test/imu", rclcpp::SensorDataQoS());
+  std::vector<geometry_msgs::msg::Vector3Stamped> accel_biases;
+  std::vector<std_msgs::msg::Float64MultiArray> initialization_diagnostics;
+  const auto accel_bias_sub =
+    probe_node->create_subscription<geometry_msgs::msg::Vector3Stamped>(
+    "/ekf_stationary_bias_test/current_accel_bias", 10,
+    [&accel_biases](geometry_msgs::msg::Vector3Stamped::ConstSharedPtr message) {
+      accel_biases.push_back(*message);
+    });
+  const auto initialization_sub =
+    probe_node->create_subscription<std_msgs::msg::Float64MultiArray>(
+    "/ekf_stationary_bias_test/debug/initialization", 10,
+    [&initialization_diagnostics](std_msgs::msg::Float64MultiArray::ConstSharedPtr message) {
+      initialization_diagnostics.push_back(*message);
+    });
+
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(ekf_node);
+  executor.add_node(probe_node);
+  ASSERT_TRUE(
+    spinUntil(
+      executor, [&]() {
+        return initial_pose_pub->get_subscription_count() == 1U &&
+        imu_pub->get_subscription_count() == 1U &&
+        accel_bias_sub->get_publisher_count() == 1U &&
+        initialization_sub->get_publisher_count() == 1U;
+      }));
+
+  const auto publish_initial_pose = [&](const double time) {
+      geometry_msgs::msg::PoseStamped message;
+      message.header.stamp = stamp(time);
+      message.header.frame_id = "map";
+      message.pose.orientation.w = 1.0;
+      initial_pose_pub->publish(message);
+      spinFor(executor, 20ms);
+    };
+  const auto publish_imu = [&](const double time, const double acceleration_z) {
+      sensor_msgs::msg::Imu message;
+      message.header.stamp = stamp(time);
+      message.header.frame_id = "base_link";
+      message.orientation.w = 1.0;
+      message.linear_acceleration.z = acceleration_z;
+      imu_pub->publish(message);
+    };
+  const auto publish_initialization_sample = [&initialization_diagnostics, &executor, &publish_imu](
+    const double time, const double acceleration_z, const std::size_t expected_sample_count)
+    {
+      publish_imu(time, acceleration_z);
+      return spinUntil(
+        executor,
+        [&]() {
+          return !initialization_diagnostics.empty() &&
+          initialization_diagnostics.back().data.size() >= 6U &&
+          initialization_diagnostics.back().data[5] ==
+          static_cast<double>(expected_sample_count);
+        });
+    };
+
+  publish_initial_pose(10.0);
+  for (int index = 0; index <= 10; ++index) {
+    ASSERT_TRUE(
+      publish_initialization_sample(
+        10.0 + index * 0.0099, 9.90665, static_cast<std::size_t>(index + 1)));
+  }
+  ASSERT_GE(initialization_diagnostics.back().data.size(), 12U);
+  EXPECT_DOUBLE_EQ(
+    initialization_diagnostics.back().data[0],
+    static_cast<double>(
+      kalman_filter_localization::core::ImuStationaryInitializer::Status::kInitialized));
+  const std::size_t bias_count_before_replay = accel_biases.size();
+  publish_imu(10.11, 9.90665);
+  ASSERT_TRUE(
+    spinUntil(executor, [&]() {return accel_biases.size() > bias_count_before_replay;}));
+  const std::size_t bias_count_before_propagation = accel_biases.size();
+  publish_imu(10.12, 9.90665);
+  ASSERT_TRUE(
+    spinUntil(executor, [&]() {return accel_biases.size() > bias_count_before_propagation;}));
+
+  EXPECT_NEAR(accel_biases.back().vector.x, 0.0, 1.0e-10);
+  EXPECT_NEAR(accel_biases.back().vector.y, 0.0, 1.0e-10);
+  EXPECT_NEAR(accel_biases.back().vector.z, 0.1, 1.0e-10);
+
+  publish_initial_pose(20.0);
+  for (int index = 0; index <= 10; ++index) {
+    ASSERT_TRUE(
+      publish_initialization_sample(
+        20.0 + index * 0.0099, 9.70665, static_cast<std::size_t>(index + 1)));
+  }
+  EXPECT_DOUBLE_EQ(
+    initialization_diagnostics.back().data[0],
+    static_cast<double>(
+      kalman_filter_localization::core::ImuStationaryInitializer::Status::kInitialized));
+  const std::size_t bias_count_before_reinitialized_replay = accel_biases.size();
+  publish_imu(20.11, 9.70665);
+  ASSERT_TRUE(
+    spinUntil(
+      executor,
+      [&]() {return accel_biases.size() > bias_count_before_reinitialized_replay;}));
+  const std::size_t bias_count_before_reinitialized_propagation = accel_biases.size();
+  publish_imu(20.12, 9.70665);
+  ASSERT_TRUE(
+    spinUntil(
+      executor,
+      [&]() {return accel_biases.size() > bias_count_before_reinitialized_propagation;}));
+  EXPECT_NEAR(accel_biases.back().vector.x, 0.0, 1.0e-10);
+  EXPECT_NEAR(accel_biases.back().vector.y, 0.0, 1.0e-10);
+  EXPECT_NEAR(accel_biases.back().vector.z, -0.1, 1.0e-10);
+
+  executor.remove_node(probe_node);
+  executor.remove_node(ekf_node);
+}
