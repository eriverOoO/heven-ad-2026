+TEST(ImuStationaryInitializer, ProjectsTiltedResidualOntoBodyGravityDirection)
+{
+  ImuStationaryInitializer::Config config;
+  config.window_duration_sec = 0.1;
+  config.minimum_samples = 10U;
+  ImuStationaryInitializer initializer(config);
+  const Eigen::Vector3d gravity_direction_body(-0.5, 0.0, std::sqrt(3.0) / 2.0);
+  const Eigen::Vector3d acceleration =
+    (config.gravity_mps2 + 0.2) * gravity_direction_body;
+  for (int index = 0; index <= 10; ++index) {
+    initializer.addSample(index * 0.01, Eigen::Vector3d::Zero(), acceleration);
+  }
+
+  const auto & result = initializer.result();
+  ASSERT_EQ(result.status, ImuStationaryInitializer::Status::kInitialized);
+  const Eigen::Vector3d expected_bias(-0.1, 0.0, 0.17320508075688773);
+  EXPECT_TRUE(result.observable_accel_bias.isApprox(expected_bias, 1.0e-12));
+  EXPECT_TRUE(
+    (result.roll_pitch_orientation * (acceleration - result.observable_accel_bias)).isApprox(
+      Eigen::Vector3d(0.0, 0.0, config.gravity_mps2), 1.0e-12));
+}
