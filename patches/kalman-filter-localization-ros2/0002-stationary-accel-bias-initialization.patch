+TEST(ImuStationaryInitializer, DoesNotClaimTransverseBiasIsObservable)
+{
+  ImuStationaryInitializer::Config config;
+  config.window_duration_sec = 0.1;
+  config.minimum_samples = 10U;
+  ImuStationaryInitializer initializer(config);
+  const Eigen::Vector3d acceleration(0.1, 0.0, config.gravity_mps2);
+  for (int index = 0; index <= 10; ++index) {
+    initializer.addSample(index * 0.01, Eigen::Vector3d::Zero(), acceleration);
+  }
+
+  const auto & result = initializer.result();
+  ASSERT_EQ(result.status, ImuStationaryInitializer::Status::kInitialized);
+  const Eigen::Vector3d expected_bias(
+    5.198700349665612e-06, 0.0, 5.098183478404828e-04);
+  EXPECT_NEAR(result.observable_accel_bias.x(), expected_bias.x(), 1.0e-12);
+  EXPECT_NEAR(result.observable_accel_bias.y(), expected_bias.y(), 1.0e-12);
+  EXPECT_NEAR(result.observable_accel_bias.z(), expected_bias.z(), 1.0e-12);
+  EXPECT_LT(result.observable_accel_bias.cross(acceleration).norm(), 1.0e-12);
+  EXPECT_LT(result.observable_accel_bias.x(), 1.0e-05);
+}
