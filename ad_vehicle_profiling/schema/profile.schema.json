{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heven.example/schema/morai-longitudinal-profile-v2.json",
  "title": "MORAI longitudinal response profile",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "manifest_sha256",
    "units",
    "axes",
    "progress",
    "cells"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string"},
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "units": {"type": "object"},
    "axes": {"type": "object"},
    "progress": {"type": "object"},
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "speed_kph",
          "command_kind",
          "command_percent",
          "status",
          "valid_trial_count",
          "attempted_trial_count",
          "median_acceleration_mps2"
        ]
      }
    }
  },
  "additionalProperties": false
}
