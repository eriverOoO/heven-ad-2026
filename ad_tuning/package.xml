<?xml version="1.0"?>
<package format="3">
  <name>ad_tuning</name>
  <version>0.3.0</version>
  <description>ROS 2 MORAI controller and local-planner tuning for HEVEN AD.</description>
  <maintainer email="taeyeong@users.noreply.github.com">Taeyeong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ad_bringup</exec_depend>
  <exec_depend>ad_control</exec_depend>
  <exec_depend>ad_description</exec_depend>
  <exec_depend>ad_interfaces</exec_depend>
  <exec_depend>ad_lidar_perception</exec_depend>
  <exec_depend>ad_localization</exec_depend>
  <exec_depend>ad_morai_interfaces</exec_depend>
  <exec_depend>ad_morai_interfaces_dev</exec_depend>
  <exec_depend>ad_morai_bridge</exec_depend>
  <exec_depend>ad_morai_bridge_dev</exec_depend>
  <exec_depend>ad_planner</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
